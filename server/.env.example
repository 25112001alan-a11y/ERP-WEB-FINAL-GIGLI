# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="mysql://root:CHANGE_ME@localhost:3306/nexus_erp"
JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\""
JWT_EXPIRES_IN="8h"
# Comma separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:3000"
# Port for the API (default 3001).
# PORT=3001
# Mercado Pago (SaaS billing). Leave empty in dev: /api/billing/checkout answers 503 honestly.
# MP_ACCESS_TOKEN="TEST-xxxxxxxxxxxx-xxxxxx"
# Free-plan monthly caps (tests override these).
# BILLING_FREE_DOC_LIMIT=20
# BILLING_FREE_PRODUCT_LIMIT=10
# NEXUS platform admin (staff). When set, the server upserts this account on
# every boot and it can log into /eco. It is a PlatformUser: no company, no
# company data. Never commit real credentials.
# PLATFORM_ADMIN_EMAIL="admin@nexus.test"
# PLATFORM_ADMIN_PASSWORD="change-me-8-chars-min"
